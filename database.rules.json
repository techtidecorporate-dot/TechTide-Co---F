{
  "rules": {
    "cookie_consents": {
      ".read": "auth != null",
      ".write": "newData.hasChildren(['visitorId', 'consentStatus'])",
      ".indexOn": ["visitorId", "consentStatus"]
    },
    "page_visits": {
      ".read": "auth != null",
      ".write": "newData.hasChildren(['visitorId', 'pageUrl'])",
      ".indexOn": ["visitorId"]
    },
    "leads": {
      ".read": "auth != null",
      ".write": "newData.hasChildren(['visitorId', 'name', 'email'])",
      ".indexOn": ["visitorId"]
    },
    "lead_scores": {
      ".read": "auth != null",
      ".write": "newData.hasChildren(['visitorId', 'score'])",
      ".indexOn": ["visitorId"]
    },
    "messages": {
      ".read": "auth != null",
      ".write": "newData.hasChildren(['name', 'email'])",
      ".indexOn": ["visitorId", "createdAt"]
    },
    "users": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["email"]
    },
    "blogs": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["slug", "createdAt"]
    },
    "services": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["slug", "createdAt"]
    },
    "jobs": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["createdAt"]
    },
    "job-positions": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["createdAt"]
    },
    "talent-pool": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["createdAt"]
    },
    "audits": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["createdAt"]
    },
    "strategy-calls": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["createdAt"]
    },
    "partners": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["createdAt"]
    },
    "subscribers": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["createdAt"]
    },
    "job-resumes": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "$other": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
