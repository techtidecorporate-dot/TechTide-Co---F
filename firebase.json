{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/sitemap.xml",
        "function": "sitemapFeed"
      },
      {
        "source": "/rss.xml",
        "function": "rssFeed"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
